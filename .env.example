# PostgreSQL
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=growth_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DSN used by the containerized app (resolves "postgres" via the Docker network).
DATABASE_URL=postgresql://analytics:change_me_locally@postgres:5432/growth_platform

# Same database, reached from the HOST (ingestion CLI, dbt, psql, ad-hoc scripts).
# Host port is 5433, not 5432 - docker-compose.yml maps it that way because many
# dev machines already run a native Postgres on 5432, which otherwise silently
# intercepts the connection. Export this before running ingestion/dbt locally.
HOST_DATABASE_URL=postgresql://analytics:change_me_locally@localhost:5433/growth_platform

# Read-only role used exclusively by the AI Data Analyst Agent (created in a later phase)
READ_ONLY_DATABASE_URL=postgresql://analytics_ro:change_me_locally@postgres:5432/growth_platform

# Analytics API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# AI agent (optional — platform must run without this being set)
LLM_PROVIDER=none
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=

# Data generation
RANDOM_SEED=42
