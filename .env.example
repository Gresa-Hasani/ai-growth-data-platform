# PostgreSQL
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=growth_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Host-side port for the postgres container (docker-compose.yml maps
# ${POSTGRES_HOST_PORT:-5433}:5432). Default 5433 because many dev machines
# already run a native Postgres on 5432, which otherwise silently
# intercepts the connection. Override this (and HOST_DATABASE_URL/
# DBT_POSTGRES_PORT below) if 5433 is ALSO already taken on your machine.
# POSTGRES_HOST_PORT=5433
# DBT_POSTGRES_HOST=localhost
# DBT_POSTGRES_PORT=5433

# Full DSN used by the containerized app (resolves "postgres" via the Docker network).
DATABASE_URL=postgresql://analytics:change_me_locally@postgres:5432/growth_platform

# Same database, reached from the HOST (ingestion CLI, dbt, psql, ad-hoc scripts).
# Export this before running ingestion/dbt locally - must match POSTGRES_HOST_PORT above.
HOST_DATABASE_URL=postgresql://analytics:change_me_locally@localhost:5433/growth_platform

# Phase 10: a least-privilege Postgres role (SELECT on analytics/monitoring
# only, plus INSERT on monitoring.ai_query_logs only - see
# app/db/security_roles.sh). Every Analytics API and AI Agent read request
# is served through this role via app/db/session.py's read_only_engine,
# which also forces a database-enforced read-only transaction regardless of
# the role's own grants. If unset, falls back to DATABASE_URL (still
# database-enforced read-only, just without the separate role) - see
# app/db/session.py and docs/security_and_sql_validation.md.
ANALYTICS_RO_PASSWORD=change_me_locally_ro
READ_ONLY_DATABASE_URL=postgresql://analytics_ro:change_me_locally_ro@postgres:5432/growth_platform

# Same role, reached from the HOST (tests, ad-hoc psql) - must match
# POSTGRES_HOST_PORT above, mirroring the DATABASE_URL/HOST_DATABASE_URL split.
HOST_READ_ONLY_DATABASE_URL=postgresql://analytics_ro:change_me_locally_ro@localhost:5433/growth_platform

# Analytics API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# AI Data Analyst Agent (Phase 9). The platform and every non-agent endpoint
# run with zero commercial API credentials - Ollama (local-only) is the
# default provider and requires nothing here beyond having Ollama installed
# and the model pulled. OpenAI/Anthropic are strictly opt-in: they are never
# called unless LLM_PROVIDER is explicitly set to "openai"/"anthropic" AND
# the matching *_API_KEY is set - there is no automatic fallback between
# providers.
LLM_PROVIDER=ollama

# Ollama. "localhost" works when Ollama runs on the same host as the API
# process (e.g. running the API outside Docker). When the API runs inside
# docker-compose, OLLAMA_BASE_URL already defaults to
# http://host.docker.internal:11434 there instead - see docker-compose.yml.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Bounds on every agent request, regardless of provider.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_TOOL_CALLS=1
LLM_MAX_QUESTION_LENGTH=500

# OpenAI - opt-in only (LLM_PROVIDER=openai). Requires `pip install -e ".[openai]"`.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic - opt-in only (LLM_PROVIDER=anthropic). Requires `pip install -e ".[anthropic]"`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# If true, a failed monitoring.ai_query_logs write raises instead of being
# swallowed as a non-blocking, logged warning. Default false: an audit-log
# failure must never prevent the user from getting their analytical answer.
AGENT_AUDIT_LOG_FAILURES_BLOCK_REQUEST=false

# Data generation
RANDOM_SEED=42
